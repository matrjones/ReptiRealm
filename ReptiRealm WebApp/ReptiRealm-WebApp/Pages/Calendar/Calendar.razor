@page "/calendar"
@using Heron.MudCalendar
@using MudBlazor
@using ReptiRealm_WebApp.Models.DTOs
@using ReptiRealm_WebApp.Models.Enums
@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals

<PageTitle>Calendar</PageTitle>

<PageSection title="Calendar" >
    <Actions>
        <QuickActionButton Icon="bi-plus-lg"
                           Text="New Event" />
    </Actions>
</PageSection>

<MudCalendar 
            T="CustomItem" 
            Items="_events" 
            Style="background-color: #001000; color: #CCDF92;" 
            Color="MudBlazor.Color.Primary" 
            Height="600" 
            MonthCellMinHeight="100" >
    <CellTemplate>
        <a @onclick="@(() => ShowEventModal(context))">
            <div style="width: 100%; height: 100%; background-color: #103010; border: 2px solid #CCDF92; display: flex; align-items: center; justify-content: center;">
                    <MudText Style="color: #ffffff;" Typo="Typo.body1" Align="Align.Center">
                        @(context.Title)
                    </MudText>
            </div>
        </a>
    </CellTemplate>
</MudCalendar>

<ConfirmationDialog @bind-IsOpen="_showFeedModal"
                    Title="@_modalData.Title" >
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Reptile</th>
                    <th>Sex</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feedEvent in _modalData.Events)
                {
                    <tr>
                        <td>@feedEvent.Reptile.Name</td>
                        <td>
                            <i class="@feedEvent.Reptile.Sex.GetSymbol()"></i>
                        </td>
                    </tr>
                }
            </tbody>
        </table>           
</ConfirmationDialog>

<ConfirmationDialog @bind-IsOpen="_showDefecationModal"
                    Title="@_modalData.Title">
</ConfirmationDialog>

@code {
    private bool _showFeedModal;
    private bool _showDefecationModal;

    private CustomItem _modalData { get; set; } = new();
    private List<CustomItem> _events = new()
    {
        new CustomItem
        {
            AllDay = true,
            Start = DateTime.Today,
            End = DateTime.Today.AddHours(2),
            Type = EventType.Feed,
            Events = new()
            {
                new FeedEvent{
                    Reptile = new Reptile
                    {
                        Id = new Guid(),
                        Name = "Ra",
                        Sex = Sex.Male
                    }
                },
                new FeedEvent{
                    Reptile = new Reptile
                    {
                        Id = new Guid(),
                        Name = "Kaiba",
                        Sex = Sex.Female
                    }
                }
            }
        },
        new CustomItem
        {
            AllDay = true,
            Start = DateTime.Today,
            End = DateTime.Today.AddHours(2),
            Type = EventType.Defecation
        }
    };

    private Task ShowEventModal(CustomItem customItem)
    {
        switch (customItem.Type)
        {
            case EventType.Feed:
                ShowFeedModal(customItem);
                break;
            case EventType.Defecation:
                ShowDefecationModal(customItem);
                break;

            default:
                break;
        }

        return Task.CompletedTask;
    }

    private void ShowFeedModal(CustomItem customItem)
    {
        _modalData = customItem;
        _showFeedModal = true;
    }

    private void ShowDefecationModal(CustomItem customItem)
    {
        _modalData= customItem;
        _showDefecationModal = true;
    }

    private class CustomItem : CalendarItem
    {
        public string Title => this.Type.ToString();
        public EventType Type { get; set; }
        public Color Color { get; set; } = MudBlazor.Color.Secondary;
        public List<Event> Events { get; set; } = new();
    }
}