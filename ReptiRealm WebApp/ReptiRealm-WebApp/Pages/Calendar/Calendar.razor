@page "/calendar"

@using Radzen
@using Radzen.Blazor
@using ReptiRealm_WebApp.Models.DTOs
@using ReptiRealm_WebApp.Models.Enums
@using ReptiRealm_WebApp.Pages.Calendar.Components
@using ReptiRealm_WebApp.Pages.Calendar.Properties
@using ReptiRealm_WebApp.Pages.Shared.Components

<PageTitle>Calendar</PageTitle>

<PageSection Title="Calendar">
    <Actions>
        <QuickActionButton Icon="bi-plus-lg"
                           Text="New Event" />
    </Actions>
</PageSection>

<RadzenScheduler TItem="CalendarItem"
                 Data="@_events"
                 StartProperty="Start"
                 EndProperty="End"
                 TextProperty="Title"
                 SelectedIndex="0"
                 SlotSelect="@OnSlotSelect"
                 AppointmentSelect="@OnAppointmentSelect"
                 AppointmentRender="@OnAppointmentRender"
                 Style="height:600px">

    <ChildContent>
        <RadzenMonthView />
    </ChildContent>

    <Template Context="appointment">
        <div class="p-1">
            @switch (appointment.Type)
            {
                case TaskType.Feed:
                    <b>🦗 Feed</b>
                    break;

                case TaskType.Defecation:
                    <b>💩 Defecation</b>
                    break;
            }

            <div>@appointment.Title</div>
        </div>
    </Template>

</RadzenScheduler>

<FeedDialog @bind-IsOpen="_showFeedModal" Data="_modalData" />
<DefecationDialog @bind-IsOpen="_showDefecationModal" Data="_modalData" />

@code {

    private bool _showFeedModal;
    private bool _showDefecationModal;

    private CalendarItem _modalData = new();

    private List<CalendarItem> _events = new()
    {
        new()
        {
            AllDay = true,
            Start = DateTime.Today,
            End = DateTime.Today.AddHours(2),
            Type = TaskType.Feed,
            Events = new()
            {
                new FeedActivity
                {
                    Reptile = new()
                    {
                        Id = Guid.NewGuid(),
                        Name = "Ra",
                        Sex = Sex.Male
                    }
                },
                new FeedActivity
                {
                    Reptile = new()
                    {
                        Id = Guid.NewGuid(),
                        Name = "Kaiba",
                        Sex = Sex.Female
                    }
                }
            }
        },
        new()
        {
            AllDay = true,
            Start = DateTime.Today,
            End = DateTime.Today.AddHours(1),
            Type = TaskType.Defecation
        }
    };

    private void OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<CalendarItem> args)
    {
        ShowEventModal(args.Data!);
    }

    void OnAppointmentRender(SchedulerAppointmentRenderEventArgs<CalendarItem> args)
    {
        // Never call StateHasChanged in AppointmentRender - would lead to infinite loop
        switch (args.Data!.Type)
        {
            case TaskType.Feed:
                args.Attributes["style"] = "background: green";
                break;

            case TaskType.Defecation:
                args.Attributes["style"] = "background: brown";
                break;

            default:
                args.Attributes["style"] = "background: blue";
                break;
        }
    }

    private void OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        // Optional: Create a new event when clicking an empty day.
    }

    private void ShowEventModal(CalendarItem item)
    {
        _modalData = item;

        _showFeedModal = false;
        _showDefecationModal = false;

        switch (item.Type)
        {
            case TaskType.Feed:
                _showFeedModal = true;
                break;

            case TaskType.Defecation:
                _showDefecationModal = true;
                break;
        }
    }
}