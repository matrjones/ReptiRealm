<button class="confirm-button"
        disabled="@IsDisabled"
        @onclick="OnClick">
    @Label
</button>


@code {
    [Parameter]
    public string Label { get; set; } = "Confirm";

    [Parameter]
    public EventCallback OnClick { get; set; }
    
    [Parameter]
    public bool IsDisabled { get; set; }
}
