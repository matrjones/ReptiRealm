@using ReptiRealm_WebApp.Pages.Shared.Components

@if (IsOpen)
{
    <div class="dialog-overlay">
        <div class="confirmation-dialog">
            @if (OnlyCloseIcon)
            {
                <button class="close-button" @onclick="HandleCancel">
                    <i class="@CloseIcon"></i>
                </button>
            }

            <div class="title-section">
                <div class="title">
                    @Title
                </div>
                @if (!string.IsNullOrWhiteSpace(WarningMessage))
                {
                    <div class="warning-message">
                        <i class="@WarningIcon"></i>
                        <span>@WarningMessage</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="message">
                        @Message
                    </div>
                }
            </div>
            <div class="child-content">
                @ChildContent
            </div>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-message">
                    <i class="@ErrorIcon"></i>
                    <span>@ErrorMessage</span>
                </div>
            }
            <div class="buttons">
                @if (!OnlyCloseIcon)
                {
                    <CancelButton OnClick="HandleCancel" />
                    <ConfirmButton OnClick="HandleSuccess" />
                }
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool OnlyCloseIcon { get; set; }
    [Parameter] public string? CloseIcon { get; set; } = "bi bi-x-lg";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? WarningIcon { get; set; } = "bi bi-exclamation-circle";
    [Parameter] public string? WarningMessage { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? ErrorIcon { get; set; } = "bi bi-dash-circle";
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    


    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
        await Close(false);
    }

    private async Task HandleSuccess()
    {
        await OnConfirm.InvokeAsync();
        await Close(false);
    }

    private async Task Close(bool value) => await IsOpenChanged.InvokeAsync(value);
}