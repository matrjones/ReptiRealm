@using ReptiRealm_WebApp.Pages.Shared.Components

@if(IsOpen)
{
    <div class="dialog-overlay">
        <div class="display-dialog">
            <div class="title-section">
                <span class="title">
                    @Title
                </span>
                @if (IsEditable)
                {
                    <button type="button"
                            class="title-icon-button"
                            @onclick="HandleTitleIconClick">
                        <i class="@EditIcon"></i>
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(WarningMessage))
            {
                <div class="warning-message">
                    <i class="@WarningIcon"></i>
                    <span>@WarningMessage</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="message">
                    @Message
                </div>
            }

            <div class="child-content">
                @ChildContent
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-message">
                    <i class="@ErrorIcon"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            <div class="buttons">
                <CancelButton Label="Close"
                              OnClick="HandleClose" />
            </div>
        </div>
    </div>
}


@code {
    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback OnTitleIconClick { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public required string Title { get; set; }

    [Parameter]
    public string EditIcon { get; set; } = "bi bi-pencil";

    [Parameter]
    public bool IsEditable { get; set; }

    [Parameter]
    public string? WarningIcon { get; set; } = "bi bi-exclamation-circle";

    [Parameter]
    public string? WarningMessage { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string ErrorIcon { get; set; } = "bi bi-dash-circle";

    [Parameter]
    public string? ErrorMessage { get; set; }

    private async Task HandleTitleIconClick()
    {
        await OnTitleIconClick.InvokeAsync();
    }

    private async Task HandleClose()
    {
        await OnCancel.InvokeAsync();
        await Close(false);
    }

    private async Task Close(bool value) => await IsOpenChanged.InvokeAsync(value);
}