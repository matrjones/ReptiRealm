@using ReptiRealm_WebApp.Pages.Shared.Components

<ConfirmationDialog IsOpen="IsOpen"
IsOpenChanged="IsOpenChanged"
Title="@Title">
    <ChildContent>
        <CheckboxItem Item="Ra" />
        <CheckboxItem Item="Kaiba" />
    </ChildContent>
</ConfirmationDialog>


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public bool HasOverdueTasks { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

}
