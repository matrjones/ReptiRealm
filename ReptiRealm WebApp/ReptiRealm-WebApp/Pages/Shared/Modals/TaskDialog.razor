@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Models.DTOs

<ConfirmationDialog IsOpen="IsOpen"
                    IsOpenChanged="IsOpenChanged"
                    Title="@Title">

    <ChildContent>
        <div class="checklist-content">
            @if (_hasOverdueTasks)
            {
                <div class="task-columns">
                    <div class="column">
                        <Checklist Title="Due Today"
                                   Tasks="_currentTasks" />
                    </div>

                    <div class="divider"></div>

                    <div class="column">
                        <Checklist Title="Overdue"
                                   Tasks="_overdueTasks" />
                    </div>
                </div>
            }
            else
            {
                <Checklist Tasks="_currentTasks" />
            }
        </div>
    </ChildContent>
    
</ConfirmationDialog>



@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public required IEnumerable<Activity> Tasks { get; set; }

    private IEnumerable<Activity> _currentTasks => Tasks.Where(t => !t.IsOverdue);
    private IEnumerable<Activity> _overdueTasks => Tasks.Where(t => t.IsOverdue);
    private bool _hasOverdueTasks => _overdueTasks.Any();
}
