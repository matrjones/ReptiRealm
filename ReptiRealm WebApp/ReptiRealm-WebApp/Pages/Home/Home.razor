@page "/"

@using ReptiRealm_WebApp.Models.DTOs
@using ReptiRealm_WebApp.Models.Enums
@using ReptiRealm_WebApp.Pages.Home.Components
@using ReptiRealm_WebApp.Pages.Home.Modals
@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals
@using ReptiRealm_WebApp.Services.Api.Interfaces
@using ReptiRealm_WebApp.Services.Auth

@inject IReptileApiService apiService
@inject AuthApiService authApiService


<PageTitle>Home</PageTitle>

<div class="homepage">
    <div class="welcome-section">
        <PageSection Title=" Welcome, ReptiKeeper!">
            <Actions>
                <QuickActionButton Icon="bi-plus-lg"
                                   Text="New Reptile"
                                   OnClick="OpenAddReptileDialog" />
            </Actions>
        </PageSection>
    </div>

    <div class="agenda-section">
        <PageSection Title="Today's Agenda"
        IsTitle="false">
            <ChildContent>
                <div class="agenda-tasks">
                    <AgendaCard Icon="bi-fork-knife"
                                AgendaTotal="@_feedActivities.Count"
                                AgendaDescription="Feeds"
                                OnClick='() => OpenTaskDialog(ActivityType.Feed)' />

                    <AgendaCard Icon="bi-droplet"
                                AgendaTotal="@_waterActivities.Count"
                                AgendaDescription="Waters"
                                OnClick='() => OpenTaskDialog(ActivityType.Water)' />

                    <AgendaCard Icon="bi-layers"
                                AgendaTotal="@_substrateActivities.Count"
                                AgendaDescription="Substrates"
                                OnClick='() => OpenTaskDialog(ActivityType.Substrate)' />
                </div>
            </ChildContent>
        </PageSection>
    </div>

    <div class="reptiles-section">
        <PageSection Title="My Reptiles"
        IsTitle="false">
            <Actions>
                <SearchBar Placeholder="Search reptiles..."
                           @bind-Value="SearchText" />
            </Actions>
            <ChildContent>
                <div class="reptile-grid">
                    @foreach (var reptile in FilteredReptiles)
                    {
                        <ReptileCard Name="@reptile.Name"
                                     Species="@reptile.Species"
                                     Sex="@reptile.Sex" />
                    }
                    <AddNewReptileCard OnClick="OpenAddReptileDialog"/>
                </div>
            </ChildContent>
        </PageSection>
    </div>
</div>

<AddNewReptileDialog @bind-IsOpen="ShowReptileDialog" />

<ActivityDialog Title="@_activityTitle"
            Activities="@_activities"
            @bind-IsOpen="ShowActivityDialog" />


@code {
    private List<ReptileCardModel> Reptiles = new();
    private IEnumerable<ReptileCardModel> FilteredReptiles => Reptiles.Where(r => r.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Activity> _activities = new List<Activity>();

    private bool ShowReptileDialog;
    private bool ShowActivityDialog;

    private string SearchText = string.Empty;
    private string _activityTitle = "Feeds";

    protected override async Task OnInitializedAsync()
    {
        Reptiles = await apiService.GetAllReptiles() ?? new List<ReptileCardModel>();
    }

    private async Task OpenAddReptileDialog()
    {
        ShowReptileDialog = true;
        await Task.CompletedTask;
    }

    private async Task CloseAddReptileDialog()
    {
        ShowReptileDialog = false;
        await Task.CompletedTask;
    }

    private async Task OpenTaskDialog(ActivityType activityType)
    {
        _activityTitle = activityType switch
        {
            ActivityType.Feed => "Feeds",
            ActivityType.Water => "Waters",
            ActivityType.Substrate => "Substrates",
            _ => activityType.ToString()
        };

        _activities = activityType switch
        {
            ActivityType.Feed => _feedActivities,
            ActivityType.Water => _waterActivities,
            ActivityType.Substrate => _substrateActivities,
            _ => new List<Activity>()
        };

        ShowActivityDialog = true;
        await Task.CompletedTask;
    }

    private async Task CloseTaskDialog()
    {
        ShowActivityDialog = false;
        await Task.CompletedTask;
    }

    private List<FeedActivity> _feedActivities = new List<FeedActivity>
    {
        new FeedActivity
        {
            Reptile = new Reptile
            {
                Id = new Guid(),
                Name = "Ra",
                Sex = Sex.Unknown
            }
        },
        new FeedActivity
        {
            Reptile = new Reptile
            {
                Id = new Guid(),
                Name = "Jiggy Mc Jigsaw",
                Sex = Sex.Unknown
            },
            IsOverdue = true
        }
    };

    private List<WaterActivity> _waterActivities = new List<WaterActivity>
    {
        new WaterActivity
        {
            Reptile = new Models.DTOs.Reptile
            {
                Id = new Guid(),
                Name = "Ra",
                Sex = Sex.Unknown
            }
        }
    };

    private List<SubstrateActivity> _substrateActivities = new List<SubstrateActivity>
    {
        new SubstrateActivity
        {
            Reptile = new Models.DTOs.Reptile
            {
                Id = new Guid(),
                Name = "Ra",
                Sex = Sex.Unknown
            },
            IsOverdue = true
        }
    };
}
