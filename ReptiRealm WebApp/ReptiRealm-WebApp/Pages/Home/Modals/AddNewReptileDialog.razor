@using ReptiRealm_WebApp.Models.DTOs
@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals
@using ReptiRealm_WebApp.Pages.Home.Models
@using ReptiRealm_WebApp.Services.Api.Interfaces
@using ReptiRealm_WebApp.Shared.Components
@inherits DialogBase<AddReptile>
@inject IReptileApiService apiService

<ConfirmationDialog IsOpen="IsOpen"
                    Title="Add New Reptile" 
                    OnConfirm="CreateReptile"
                    OnCancel="HandleCancel">
    <ChildContent>
        <div class="questions-section">
            <div class="question">
                <TextInputQuestion IsRequired="true"
                                   Title="Name"
                                   Placeholder="Name"
                                   @bind-Value="Model.Name" />
            </div>
            <div class="question">
                <SelectSexQuestion IsRequired="false"
                                   Title="Sex"
                                   @bind-Value="Model.Sex" />
            </div>
            <div class="question">
                <TextInputQuestion Title="Species"
                                   Placeholder="Species"
                                   @bind-Value="Model.Species" />
            </div>
            <div class="question">
                <DateSelection IsRequired="false"
                               Title="Date of Birth"
                               Message="(DD/MM/YYYY)"
                               @bind-Value="Model.DateOfBirth" />
            </div>
            <div class="question">
                <DateSelection IsRequired="false"
                               Title="Date Obtained"
                               Message="(DD/MM/YYYY)"
                               @bind-Value="Model.DateObtained" />
            </div>
        </div>
    </ChildContent>
</ConfirmationDialog>


@code {
    [Parameter]
    public EventCallback<ReptileCardDto> OnAdded { get; set; }

    private async Task CreateReptile()
    {
        var created = await apiService.AddReptile(Model);

        if (created is not null)
        {
            var card = new ReptileCardDto
            {
                Id = created.Id,
                Name = created.Name,
                Sex = created.Sex,
                Species = created.Species?.Name,
                DateOfBirth = created.DateOfBirth,
                DateObtained = created.DateObtained
            };

            await OnAdded.InvokeAsync(card);
            // Close the dialog on successful add
            IsOpen = false;
        }
    }
    private void HandleCancel()
    {
        IsOpen = false;
    }
}
