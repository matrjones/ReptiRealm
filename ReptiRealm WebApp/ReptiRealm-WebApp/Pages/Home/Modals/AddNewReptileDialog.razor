@using ReptiRealm_WebApp.Models.Enums
@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals

<ConfirmationDialog IsOpen="IsOpen"
                    IsOpenChanged="IsOpenChanged"
                    Title="Add New Reptile" >
    <ChildContent>
        <div class="questions-section">
            <div class="question">
                <TextInputQuestion IsRequired="true"
                                   Title="Name"
                                   Placeholder="Name"
                                   @bind-Value="_name" />
            </div>
            <div class="question">
                <SelectSexQuestion IsRequired="false"
                                   Title="Sex"
                                   @bind-Value="_sex" />
            </div>
            <div class="question">
                <TextInputQuestion Title="Species"
                                   Placeholder="Species"
                                   @bind-Value="_species" />
            </div>
            <div class="question">
                <DateSelection IsRequired="false"
                               Title="Date of Birth"
                               Message="(DD/MM/YYYY)"
                               @bind-Value="_dateOfBirth" />
            </div>
            <div class="question">
                <DateSelection IsRequired="false"
                               title="Date Obtained"
                               Message="(DD/MM/YYYY)"
                               @bind-Value="_dateObtained" />
            </div>
        </div>
    </ChildContent>
</ConfirmationDialog>


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private string? _name;
    private Sex? _sex;
    private string? _species;
    private DateTime? _dateOfBirth;
    private DateTime? _dateObtained;
}
