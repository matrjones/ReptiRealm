@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals
@using ReptiRealm_WebApp.Models.Enums

<BaseDialog @bind-IsOpen="@IsOpen"
Title="Add New Reptile">
    <ChildContent>
        <TextInput IsRequired="true"
        Title="Name"
        Placeholder="Enter name"
        @bind-Value="_name" />

        <MultiSelectBar Title="Sex"
        Options="@SexOptions"
        @bind-Value="_sex" />

        <TextInput Title="Species"
        Placeholder="Enter species"
        @bind-Value="_species" />

        <DateInput Title="Date of Birth"
        Message="DD/MM/YY or MM/YY"
        @bind-Value="_dob" />

        <DateInput Title="Date Obtained"
        Message="DD/MM/YY"
        @bind-Value="_dateObtained" />

        <!-- User can type a morph and add it to list -->

    </ChildContent>
</BaseDialog>


@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string? _name;
    private Sex _sex = Sex.Unknown;
    private string? _species;
    private DateOnly? _dob;
    private DateOnly? _dateObtained;
    private readonly IEnumerable<Sex> SexOptions = Enum.GetValues<Sex>();

    protected override void OnParametersSet()
    {
        _name = null;
        _sex = Sex.Unknown;
        _species = null;
        _dob = null;
        _dateObtained = null;
    }
}
