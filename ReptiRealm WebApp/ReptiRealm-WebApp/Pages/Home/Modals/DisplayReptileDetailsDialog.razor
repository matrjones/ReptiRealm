@using ReptiRealm_WebApp.Models.Enums
@using ReptiRealm_WebApp.Pages.Home.Models
@using ReptiRealm_WebApp.Pages.Shared.Components
@using ReptiRealm_WebApp.Pages.Shared.Modals
@using ReptiRealm_WebApp.Models.DTOs


<DisplayDialog IsOpen="IsOpen"
               IsOpenChanged="IsOpenChanged"
               Title="@Reptile.Name">
    
    <LeftTitleSection>
        <button type="button"
                class="icon-button add-icon-button"
                @onclick="HandleAddIconClick">
            <i class="bi bi-plus-lg"></i>
        </button>
        
        <button type="button"
                class="icon-button view-history-icon-button"
                @onclick="HandleViewHistoryIconClick">
            <i class="bi bi-card-list"></i>
        </button>
    </LeftTitleSection>

    <RightTitleSection>
        <button type="button"
                class="icon-button edit-icon-button"
                @onclick="HandleEditIconClick">
            <i class="bi bi-pencil"></i>
        </button>
        
        <button type="button"
                class="icon-button delete-icon-button"
                @onclick="HandleDeleteIconClick">
            <i class="bi bi-trash"></i>
        </button>
    </RightTitleSection>

    <ChildContent>
        <div class="detail-items">
            <div class="detail-item">
                <DisplayDetailText Title="Name"
                                   Value="@Reptile.Name" />
            </div>

            <div class="detail-item">
                <DisplaySexSelection Title="Sex"
                                     Value="@Reptile.Sex" />
            </div>


            @if (!string.IsNullOrWhiteSpace(Reptile.Species))
            {
                <div class="detail-item">
                    <DisplayDetailText Title="Species"
                                       Value="@Reptile.Species" />
                </div>
            }

            @if (Reptile.DateOfBirth.HasValue)
            {
                <div class="detail-item">
                    <DisplayDetailText Title="Date of Birth"
                                       Value="@Reptile.DateOfBirth"
                                       Format="dd/MM/yyyy" />
                </div>
            }

            @if (Reptile.DateObtained.HasValue)
            {
                <div class="detail-item">
                    <DisplayDetailText Title="Date Obtained"
                                       Value="@Reptile.DateObtained"
                                       Format="dd/MM/yyyy" />
                </div>
            }
        </div>
    </ChildContent>
</DisplayDialog>


@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback OnAddIconClick { get; set; }

    [Parameter]
    public EventCallback OnViewHistoryIconClick { get; set; }

    [Parameter]
    public EventCallback OnEditIconClick { get; set; }

    [Parameter]
    public EventCallback OnDeleteIconClick { get; set; }

    [Parameter]
    public required ReptileCardDto Reptile { get; set; }

    private async Task HandleAddIconClick()
    {
        await OnAddIconClick.InvokeAsync();
    }

    private async Task HandleViewHistoryIconClick()
    {
        await OnViewHistoryIconClick.InvokeAsync();
    }

    private async Task HandleEditIconClick()
    {
        await OnEditIconClick.InvokeAsync();
    }

    private async Task HandleDeleteIconClick()
    {
        await OnDeleteIconClick.InvokeAsync();
    }
}
