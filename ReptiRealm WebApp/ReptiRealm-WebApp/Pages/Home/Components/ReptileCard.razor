@using ReptiRealm_WebApp.Models.Enums

<button class="reptile-card"
        @onclick="OnClick">
    <div class="name-and-sex">
        <span class="name">
            @Name
        </span>
        @if(!string.IsNullOrWhiteSpace(Sex.GetSymbol()))
        {
            <span class="@Sex.GetSymbol()" />
        }
    </div>

    @if(!string.IsNullOrWhiteSpace(Species))
    {
        <div class="species">
            <p class="species-text">
                @Species
            </p>
        </div>
    }
</button>


@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    required public string Name { get; set; }

    [Parameter]
    public Sex Sex { get; set; } = Sex.Unknown;

    [Parameter]
    public string? Species { get; set; }


    private string SexIcon => Sex switch
    {
        Sex.Male => "bi bi-gender-male",
        Sex.Female => "bi bi-gender-female",
        _ => string.Empty
    };
}
