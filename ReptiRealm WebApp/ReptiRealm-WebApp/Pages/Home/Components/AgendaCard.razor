<button class="agenda-card"
        @onclick="OnClick">
    <span class="bi @Icon"></span>
    <div class="agenda-text">
        <div class="agenda-total">
            @AgendaTotal
        </div>
        <div class="agenda-description">
            @AgendaDescription
        </div>
    </div>
</button>


@code {
    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    required public string Icon { get; set; }

    [Parameter]
    public int AgendaTotal { get; set; }

    [Parameter]
    required public string AgendaDescription { get; set; }
}
