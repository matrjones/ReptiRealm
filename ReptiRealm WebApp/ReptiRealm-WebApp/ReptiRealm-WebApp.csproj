<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReptiRealm_WebApp</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="Pages\Calendar\Modals\" />
    <Folder Include="Pages\Calendar\Resources\" />
    <Folder Include="Pages\Food\Components\" />
    <Folder Include="Pages\Food\Modals\" />
    <Folder Include="Pages\Food\Resources\" />
    <Folder Include="Pages\Home\Resources\" />
    <Folder Include="Pages\Reptile\Components\" />
    <Folder Include="Pages\Reptile\Modals\" />
    <Folder Include="Pages\Reptile\Resources\" />
    <Folder Include="Pages\Shared\Resources\" />
    <Folder Include="Pages\Tasks\Components\" />
    <Folder Include="Pages\Tasks\Modals\" />
    <Folder Include="Pages\Tasks\Resources\" />
    <Folder Include="Shared\Components\" />
    <Folder Include="Shared\Resources\" />
    <Folder Include="wwwroot\Js\" />
    <Folder Include="wwwroot\Images\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="9.0.18" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.18" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

</Project>
